# --- Required ---------------------------------------------------------
# GitHub Personal Access Token, scoped to ONE repo, permissions: Contents → Read & Write.
# Repo → Settings → Developer settings → Personal access tokens → Fine-grained.
GH_TOKEN=github_pat_REPLACE_ME

# Your repo as "owner/name" (the one Netlify deploys from).
GH_REPO=yourname/shopping-app

# --- Optional ---------------------------------------------------------
GIT_NAME=Shopping Price Feeder
GIT_EMAIL=price-feeder@local

# Daily full scrape (UTC cron). Default in code: 0 19 * * *  = 03:00 AWST.
#CRON_FULL=0 19 * * *
# Weekly specials sweep (UTC cron). Default in code: 0 0 * * 3 = 08:00 AWST Wednesday.
#CRON_SPECIALS=0 0 * * 3

# Set to 1 for a single run then exit (test mode).
#RUN_ONCE=1
